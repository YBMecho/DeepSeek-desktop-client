{
  "name": "DeepSeek",
  "version": "2.5.0",
  "description": "方便快捷打开网页内容。",
  "keywords": [
    "DeepSeek-app"
  ],
  "license": "ISC",
  "author": "YBMecho",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron-forge start",
    "start:trace": "set NODE_OPTIONS=--trace-deprecation && electron-forge start",
    "test": "npm start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "build": "node build.js",
    "build:all": "node build.js all",
    "build:squirrel": "node build.js squirrel",
    "build:inno": "node build.js inno",
    "build:package": "node build.js package",
    "build:inno:proxy": "node build.js inno 127.0.0.1:10808",
    "build:squirrel:proxy": "node build.js squirrel 127.0.0.1:10808",
    "build:all:proxy": "node build.js all 127.0.0.1:10808",
    "iss:show": "node build.js iss:show",
    "iss:set": "node build.js iss:set",
    "config:show": "node build.js config:show",
    "config:clear": "node build.js config:clear",
    "build:help": "node build.js --help"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.3",
    "@electron-forge/maker-deb": "^7.8.3",
    "@electron-forge/maker-rpm": "^7.8.3",
    "@electron-forge/maker-squirrel": "^7.8.3",
    "@electron-forge/maker-zip": "^7.8.3",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.3",
    "@electron-forge/plugin-fuses": "^7.8.3",
    "@electron-forge/plugin-webpack": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/node": "^26.2.0",
    "electron": "^37.2.6",
    "ts-loader": "^9.6.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "electron-context-menu": "^4.1.0",
    "electron-squirrel-startup": "^1.0.1"
  }
}
