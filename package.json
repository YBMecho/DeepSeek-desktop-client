{
  "name": "DeepSeek",
  "version": "2.5.1",
  "description": "方便快捷打开网页内容。",
  "keywords": [
    "DeepSeek-app"
  ],
  "license": "ISC",
  "author": "YBMecho",
  "type": "commonjs",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node node_modules/typescript-7/bin/tsc",
    "start": "npm run build && electron .",
    "start:trace": "set NODE_OPTIONS=--trace-deprecation && npm run build && electron .",
    "dev": "node node_modules/typescript-7/bin/tsc && electron .",
    "dev:watch": "node node_modules/typescript-7/bin/tsc --watch",
    "dev:start": "nodemon --watch dist --exec \"electron .\"",
    "dev:auto": "concurrently \"npm:dev:watch\" \"npm:dev:start\"",
    "test": "npm start",
    "lint": "eslint .",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.3",
    "@electron-forge/maker-deb": "^7.8.3",
    "@electron-forge/maker-rpm": "^7.8.3",
    "@electron-forge/maker-squirrel": "^7.8.3",
    "@electron-forge/maker-zip": "^7.8.3",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.3",
    "@electron-forge/plugin-fuses": "^7.8.3",
    "@electron-forge/plugin-webpack": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.4",
    "electron": "^37.2.6",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "nodemon": "^3.1.14",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "electron-context-menu": "^4.1.0",
    "electron-squirrel-startup": "^1.0.1",
    "markdown-it": "^15.0.0"
  }
}
