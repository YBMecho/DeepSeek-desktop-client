{
  "name": "DeepSeek",
  "version": "2.5.0",
  "description": "方便快捷打开网页内容。",
  "keywords": [
    "DeepSeek-app"
  ],
  "license": "ISC",
  "author": "YBMecho",
  "type": "commonjs",
  "main": "main.js",
  "build": {
    "appId": "com.deepseek.app",
    "productName": "DeepSeek",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/electron*/**"
    ],
    "files": [
      "**/*",
      "!**/*.ts",
      "!**/*.map",
      "!**/*.md",
      "!**/docs{,/**}",
      "!**/test{,/**}",
      "!**/tests{,/**}",
      "!**/.git*"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/assets/icons/lp25u-mafhn-001.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "afterPack": "scripts/optimize-asar.js"
  },
  "scripts": {
    "start": "electron-forge start",
    "start:trace": "set NODE_OPTIONS=--trace-deprecation && electron-forge start",
    "test": "npm start",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.3",
    "@electron-forge/maker-deb": "^7.8.3",
    "@electron-forge/maker-rpm": "^7.8.3",
    "@electron-forge/maker-squirrel": "^7.8.3",
    "@electron-forge/maker-zip": "^7.8.3",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.3",
    "@electron-forge/plugin-fuses": "^7.8.3",
    "@electron-forge/plugin-webpack": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/node": "^26.2.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.15.3",
    "ts-loader": "^9.6.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "electron-context-menu": "^4.1.0",
    "electron-squirrel-startup": "^1.0.1"
  }
}
